# Local database dumps and backups
/database/backups/*

# Production schema is the only migration tracked for deployment.
/database/migrations/*.php
!/database/migrations/2026_10_22_000000_create_production_schema.php

# Root project uses npm; keep package-lock.json as the dependency lockfile.
/pnpm-lock.yaml

# UIUX prototype uses pnpm; do not keep a second lockfile or source archive.
/UIUX/

